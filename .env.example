# Shared project configuration: copy to .env at the repository root.
# LLM_* values are backend-only. Never prefix secrets with VITE_.
# Frontend public variables, when needed, must use the VITE_ prefix.
PORT=3000
# URL AI Proxy BTC theo OpenAPI; thay LLM_API_KEY bang key that truoc khi chay.
LLM_BASE_URL=https://llm.codex.so
LLM_API_KEY=replace-with-your-key
LLM_TIMEOUT_MS=60000
